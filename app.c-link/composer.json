{
  "name": "clink/clink",
  "description": "C-Link Framework",
  "keywords": [
    "framework",
    "mvc",
    "clink"
  ],
  "homepage": "https://c-link.com",
  "type": "project",
  "authors": [
    {
      "name": "C-Link",
      "email": "info@c-link.com"
    }
  ],
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "construction-link/pdf_render",
        "version": "dev-main",
        "source": {
          "url": "https://github.com/construction-link/nexus.git",
          "type": "git",
          "reference": "main"
        },
        "autoload": {
          "psr-4": {
            "CL\\": "document-creator/src/CL"
          }
        }
      }
    },
    {
      "type": "vcs",
      "url": "https://github.com/construction-link/cost-planning-tool.git"
    }
  ],
  "require": {
    "php": "^8.2",
    "construction-link/pdf_render": "dev-main",
    "construction-link/cost-planning-tool": "dev-develop",
    "phpmailer/phpmailer": "~6.1",
    "aws/aws-sdk-php": "^3.288.1",
    "stripe/stripe-php": "^7.116.0",
    "fpdf/fpdf": "^1.86",
    "setasign/fpdf": "1.8.*",
    "setasign/fpdi": "^2.0",
    "jurosh/pdf-merge": "^2.1.0",
    "docusign/esign-client": "v6.17.0",
    "dompdf/dompdf": "^3.1.6",
    "mpdf/mpdf": "^8.2.5",
    "phpoffice/phpspreadsheet": "^1.30.0"
  },
  "require-dev": {
    "phpunit/phpunit": "11.5.53",
    "phpstan/phpstan": "^1.10",
    "friendsofphp/php-cs-fixer": "^3.9"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "vendor-dir": "vendor",
    "platform": {
      "php": "8.2"
    },
    "audit": {
      "ignore": [
        "CVE-2025-45769"
      ]
    }
  },
  "scripts": {
    "post-install-cmd": [
      "find vendor/construction-link/pdf_render -mindepth 1 -maxdepth 1 ! -name 'document-creator' -exec rm -rf {} +"
    ],
    "test": "phpunit",
    "prettify": "vendor/bin/php-cs-fixer fix",
    "prettify-check": "vendor/bin/php-cs-fixer fix --dry-run",
    "static-analysis": "vendor/bin/phpstan analyse -c phpstan.neon",
    "code-quality-checks": [
      "@prettify-check",
      "@static-analysis"
    ]
  }
}
