{
    "name": "construction-link/pdf_render",
    "description": "Pdf Parser Lib For Clink Docs",
    "type": "project",
    "require": {
        "spipu/html2pdf": "^5.2",
        "dompdf/dompdf": "^2.0.4",
        "mpdf/mpdf": "^8.0.17"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.3",
        "phpunit/phpunit": "11.5.53"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "robert.dean",
            "email": "robert@c-link.com"
        }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-0": {
            "CL\\" : "src",
            "App\\": "src"
        }
    },
    "config": {
        "vendor-dir": "vendor",
        "platform": {
            "php": "7.4"
        }
    }
}
